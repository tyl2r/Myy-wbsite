# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql://routeshare:routeshare@localhost:5432/routeshare?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting (per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=120
