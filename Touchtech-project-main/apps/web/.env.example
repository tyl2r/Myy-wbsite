# API
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# WebSocket (tracking gateway)
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Development mocking (MSW). Set to 'enabled' to run without a live backend.
NEXT_PUBLIC_API_MOCKING=enabled

# Map (MapLibre). Defaults to a free demo style if unset.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MAP_CENTER_LAT=59.3293
NEXT_PUBLIC_MAP_CENTER_LNG=18.0686
NEXT_PUBLIC_MAP_ZOOM=11

# Misc
NEXT_TELEMETRY_DISABLED=1
